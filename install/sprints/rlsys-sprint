#!/bin/bash

set -euo pipefail

CMD="${1:-}"
SPRINT="${2:-}"

echo "[RL.SYS RUN] $SPRINT"

if [ "$CMD" != "run" ]; then
  echo "[RUNNER] USAGE: rlsys-sprint run <sprint>"
  exit 1
fi

if [ -z "$SPRINT" ]; then
  echo "[RUNNER] ERROR: sprint name missing"
  exit 1
fi

echo "[RUNNER] RL.SYS RUNNER v1 START"
echo "[RUNNER] SPRINT: $SPRINT"

SPRINT_FILE="run-sprint-$SPRINT.sh"

# 🔒 GUARD (OBRIGATÓRIO E AUTOMÁTICO)
bash install/sprints/run-sprint-000-e-architecture-guard-core.sh "$SPRINT"

if [ $? -ne 0 ]; then
  echo "[RUNNER] BLOCKED BY ARCHITECTURE GUARD"
  exit 1
fi

# 🚀 EXECUÇÃO DO SPRINT
SPRINT_PATH="install/sprints/$SPRINT_FILE"

if [ ! -f "$SPRINT_PATH" ]; then
  echo "[RUNNER] SPRINT FILE NOT FOUND: $SPRINT_PATH"
  exit 1
fi

bash "$SPRINT_PATH"

echo "[RUNNER] RL.SYS RUNNER COMPLETE"
